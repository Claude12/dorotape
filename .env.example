# Copy to .env for running the pipeline scripts and site checks by hand.
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way. Deploying is `git pull` inside
# public_html, so a committed .env would be a secret sitting in the webroot.
#
# In GitHub Actions there is no .env at all. CI reads the repository Secrets and
# Variables below, and real environment variables always beat this file, so it
# can never quietly override what CI passes in.
#
# Full setup guide: .github/README.md


# ---------------------------------------------------------------- secrets
# In CI: Settings -> Secrets and variables -> Actions -> Secrets

# monday.com personal API token. The user it belongs to needs a MEMBER seat -
# a viewer seat reads fine and fails every write.
MONDAY_TOKEN=

# Dev server SSH access, used only by the deploy workflow. Not needed locally.
# SSH_HOST=
# SSH_USER=
# SSH_PORT=
# SSH_PRIVATE_KEY=


# ------------------------------------------------------------- variables
# In CI: the same page, the VARIABLES tab - not Secrets. The workflows read
# vars.*, so anything added as a secret is invisible to them.

# Full URL of the dev site, no trailing slash. Used by the site checks and by
# the links in monday comments. Required - nothing defaults to a site URL,
# because a default would mean a copy of this repo checks the previous
# project's site and reports a confident green about someone else's pages.
DEV_SITE_URL=

# CI only. Absolute path to the theme's git working copy on the dev server.
# Required - an unset value stops the deploy rather than guessing a target.
# DEV_THEME_PATH=~/www/example.dev/public_html/wp-content/themes/mytheme

# CI only. The remote's name IN THE SERVER'S CLONE - check with
# `git -C <path> remote -v` over SSH. It is often not "origin".
# DEV_GIT_REMOTE=origin

# CI only. Branch the server pulls.
# DEV_GIT_BRANCH=main


# --------------------------------------------------------------- optional

# Point the site checks somewhere other than DEV_SITE_URL for one run.
# SITE_URL=https://staging.example.dev

# How many URLs the checks sample. Default 24.
# SAMPLE_SIZE=24
