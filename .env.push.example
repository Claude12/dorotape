# Settings for tools/push-to-dev.sh. Copy to .env.push (gitignored) and fill in.

# Dev's SSH login.
DEV_SSH_HOST=
DEV_SSH_USER=
DEV_SSH_PORT=22
# Private key file, if the SSH agent does not already hold the login.
# DEV_SSH_KEY=~/.ssh/id_ed25519

# WordPress root on dev, the folder with wp-config.php in it. ~/ is fine.
DEV_WP_PATH=

# Site addresses, exactly as each siteurl option has them, no trailing slash.
LOCAL_URL=
DEV_URL=

# Optional. Defaults shown.
# LOCAL_WP_PATH=        three folders above the theme
# LOCAL_BIN_PATH=       where mysqldump lives, if not on the PATH (XAMPP: /Applications/XAMPP/xamppfiles/bin)
# LOCAL_PHP=php         PHP to run WP-CLI with when wp is not installed
# LOCAL_WP_CLI=         full WP-CLI command, if not plain `wp`
# LOCAL_DUMP_DIR=$HOME/wp-db-dumps   where local exports are kept; outside the web root
# DEV_BACKUP_DIR=db-backups          on dev, relative to the SSH user's home
# DEV_BACKUP_KEEP=10

# Plugins that differ between the two, space-separated slugs. The push copies
# local's list of active plugins, so without these a cache plugin that only
# dev runs would be switched off there.
LOCAL_ONLY_PLUGINS=
DEV_ONLY_PLUGINS=

# Parts of dev's database that belong to dev and are never overwritten, such
# as a plugin set up there against a live system. Space-separated. Options are
# option names, with % as a wildcard; tables are names with or without the
# table prefix. Both are put back exactly as dev had them after every push.
DEV_KEEP_OPTIONS=
DEV_KEEP_TABLES=
