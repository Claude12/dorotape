# Deploy is `git pull` on the server, so anything tracked here lands inside
# public_html. Nothing in this folder should be reachable over HTTP.
# Same exposure dorotape-migration/ has always had.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
