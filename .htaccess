# Theme-root backstop.
#
# Deploy is `git pull` inside public_html, so every tracked file is a file
# served from the webroot. bin/ and tests/ each carry their own deny rule. This
# file covers the two cases those cannot:
#
#  1. A directory that USED to be tracked. Removing dorotape-migration/ from the
#     repo makes a fresh pull delete it, but a server with an untracked or
#     stale copy keeps serving it, and that copy is exactly the one nobody
#     knows about. The rule below stays regardless of what git thinks.
#
#  2. Raw data files anywhere in the theme. Data exports are how this went
#     wrong once, and the next person to drop a .csv next to a script should
#     not have to know the history to be safe.
#
# Deliberately narrow: the theme has to keep serving its own CSS, JS, fonts and
# images, so this denies data, never assets.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^dorotape-migration/ - [F,L]
</IfModule>

# For servers without mod_rewrite, and for anything dropped loose in the theme.
<FilesMatch "\.(csv|sql|sqlite|xlsx|xls|py|dist|bak|swp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>

    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
